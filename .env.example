# ============================================================
# .env.example — Identity Hub Services
# ============================================================
# Copy this file to .env and fill in real values before running
# the production stack:
#
#   cp .env.example .env
#   # edit .env with your values
#   ./deploy.sh
#
# DO NOT commit .env to version control.
# This file (.env.example) is safe to commit — it contains no
# real secrets.
# ============================================================


# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------
# Root credentials used by docker-compose to initialise the
# MongoDB container. The auth and user services connect using
# these credentials via MONGO_URI below.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me-use-openssl-rand-hex-32
MONGO_INITDB_DATABASE=auth_db


# ------------------------------------------------------------
# Secrets
# ------------------------------------------------------------
# HS256 JWT signing secret shared by auth, user, and
# notification services. Generate with:
#   openssl rand -hex 64
JWT_SECRET=change-me-use-openssl-rand-hex-64


# ------------------------------------------------------------
# Service ports (host-side; only gateway + frontend published)
# ------------------------------------------------------------
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
FRONTEND_PORT=8085


# ------------------------------------------------------------
# Cookie settings (auth-service)
# ------------------------------------------------------------
# COOKIE_SECURE   — set true when serving over HTTPS (required
#                   for SameSite=None; enforced by the server).
#                   Set false only for plain-HTTP local dev.
# COOKIE_SAME_SITE — Lax (same-site / dev) | None (cross-site
#                    HTTPS, e.g. frontend on a different origin)
#                  | Strict (same-site, strictest)
# COOKIE_MAX_AGE  — lifetime in seconds (default: 86400 = 24 h)
# COOKIE_DOMAIN   — leave blank to match the request host;
#                   set to ".example.com" for subdomain sharing.
COOKIE_SECURE=true
COOKIE_SAME_SITE=None
COOKIE_MAX_AGE=86400
COOKIE_DOMAIN=


# ------------------------------------------------------------
# CORS — allowed origins for auth, user, notification services
# ------------------------------------------------------------
# Comma-separated list of frontend origin(s). Must match the
# exact scheme + host + port seen by the browser.
ALLOWED_ORIGINS=https://app.example.com


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Zerolog / slog level integer:
#   -1 = trace | 0 = debug | 1 = info | 2 = warn | 3 = error
LOG_LEVEL=0


# ------------------------------------------------------------
# API Gateway — rate limiting (optional overrides)
# ------------------------------------------------------------
# Token-bucket limiter applied per remote IP.
# Defaults: RPS=10, Burst=20 (see router.go).
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=20


# ------------------------------------------------------------
# Notification service — SMTP
# ------------------------------------------------------------
# Leave blank to disable email sending (notifications will be
# stored but not delivered via email).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=change-me
EMAIL_FROM=Identity Hub <notifications@example.com>


# ------------------------------------------------------------
# Kafka (internal — injected by docker-compose; no need to set
# these in .env unless you run services outside Compose)
# ------------------------------------------------------------
# KAFKA_BROKERS=kafka:9092
# KAFKA_TOPIC_USER_CREATED=user.created.v1
# KAFKA_TOPIC_USER_UPDATED=user.updated.v1
# KAFKA_TOPIC_USER_DELETED=user.deleted.v1
